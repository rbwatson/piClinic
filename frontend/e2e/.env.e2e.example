# E2E test environment configuration
# Copy to .env.e2e and fill in values — this file is gitignored.
#
# E2E_BASE_URL     — URL of the running piClinic app (dev: http://localhost)
# E2E_DB_*         — MariaDB connection for verification and teardown
#                    Use the piclinic_e2e account (SELECT + DELETE only)
# E2E_TEST_*       — Dedicated E2E test user credentials
#                    Create via sql/CreateE2ETestUser.sql

E2E_BASE_URL=http://localhost

E2E_DB_HOST=localhost
E2E_DB_PORT=3306
E2E_DB_NAME=piclinic
E2E_DB_USER=piclinic_e2e
E2E_DB_PASSWORD=changeme

E2E_TEST_USERNAME=e2e_testuser
E2E_TEST_PASSWORD=changeme
