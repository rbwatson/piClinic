# HTTP integration test environment variables
# Copy this file to .env.test and fill in the values.
#
#   cp tests/Http/.env.test.example tests/Http/.env.test
#
# .env.test is gitignored and must never be committed.
#
# Usage:
#   source tests/Http/.env.test
#   bash tests/Http/run_tests.sh

# Required: plain-text password for test staff accounts in sql/TestUsers.sql
export TEST_STAFF_PASSWORD=""

# Optional: API base URL (default: http://localhost)
# Uncomment and set if the API is not running on localhost.
# export BASE_URL=http://192.168.1.50

# Optional: path to the API .env file for DB credentials
# Uncomment and set if .env is not at /var/www/html/api/.env
# export ENV_FILE=/path/to/.env
