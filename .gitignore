# IDE and OS artifacts
.idea/
.DS_*
*.swp
*.swo
.vscode/

# Claude Code worktree metadata
.claude/

# PHP dependencies (reinstall with: composer install)
vendor/

# Node dependencies (reinstall with: npm install)
node_modules/
frontend/node_modules/

# Frontend build output (generated by: npm run build)
frontend/dist/
frontend/build/

# TypeScript build artifacts (generated by: tsc -b)
frontend/tsconfig.app.tsbuildinfo
frontend/tsconfig.node.tsbuildinfo
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
tests/Http/.env.test

# Installation config and progress (contain passwords / machine state)
tools/piclinic_setup.conf
tools/piclinic_setup.progress

# PHPStan cache
.phpstan/
**/.phpunit.result.cache

# Benchmark config files and user scripts
benchmarks/benchmark_*.conf
benchmarks/results/**

# Test coverage reports
coverage/
frontend/coverage/

# Composer lock is committed; vendor is not
# npm lock is committed; node_modules is not

# Playwright
.github/workflows/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
