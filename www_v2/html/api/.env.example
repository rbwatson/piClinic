# Application
APP_ENV=production
APP_DEBUG=false

# Database
DB_HOST=localhost
DB_USER=CTS-user
DB_PASSWORD=
DB_NAME=piclinic

# Logging
# Path must be writable by the web server (www-data)
LOG_PATH=/var/log/piclinic/
# One of: debug, info, notice, warning, error, critical
LOG_LEVEL=warning

# API
API_QUERY_LIMIT=100

# CORS
# Set to specific origin in production, e.g. http://piclinic.local
# Use * only for development
CORS_ALLOWED_ORIGIN=*
